<div class="form-group stacked">
  <span id="daavy-lightswitch-feedback-category-label">{{localize "DAAVY_LIGHTSWITCH.Feedback.Category"}}</span>
  <div class="form-fields daavy-lightswitch-feedback-categories" role="radiogroup" aria-labelledby="daavy-lightswitch-feedback-category-label">
    <label class="daavy-lightswitch-feedback-category">
      <input type="radio" name="category" value="Bug" required>
      <span>{{localize "DAAVY_LIGHTSWITCH.Feedback.Categories.Bug"}}</span>
    </label>
    <label class="daavy-lightswitch-feedback-category">
      <input type="radio" name="category" value="Suggestion" required>
      <span>{{localize "DAAVY_LIGHTSWITCH.Feedback.Categories.Suggestion"}}</span>
    </label>
  </div>
</div>

<div class="form-group stacked">
  <label for="daavy-lightswitch-feedback-message">{{localize "DAAVY_LIGHTSWITCH.Feedback.Message"}}</label>
  <textarea id="daavy-lightswitch-feedback-message" name="message" rows="8" maxlength="3000" required></textarea>
  <p class="hint">{{localize "DAAVY_LIGHTSWITCH.Feedback.MessageHint"}}</p>
</div>

<footer class="form-footer">
  <button type="button" class="daavy-lightswitch-feedback-cancel" data-action="close">
    <i class="fa-solid fa-xmark"></i>
    {{localize "DAAVY_LIGHTSWITCH.Feedback.Cancel"}}
  </button>
  <button type="submit" class="daavy-lightswitch-feedback-send">
    <i class="fa-solid fa-paper-plane"></i>
    {{localize "DAAVY_LIGHTSWITCH.Feedback.Send"}}
  </button>
</footer>
